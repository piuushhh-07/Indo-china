# ---- Server ----
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# ---- Database (managed PostgreSQL in production, e.g. Render/Railway/Neon/RDS) ----
DATABASE_URL=postgres://postgres:local_dev_only@localhost:5432/indochina_dev
# Set to true only if your provider requires SSL (most managed Postgres hosts do in production)
DATABASE_SSL=false

# ---- Sessions ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
SESSION_COOKIE_NAME=ics_session
SESSION_MAX_AGE_MS=604800000

# ---- CORS (only needed if frontend is hosted on a different origin) ----
CORS_ORIGIN=http://localhost:3000

# ---- Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys) ----
# Leave blank to keep Razorpay disabled — Cash on Delivery still works without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Admin bootstrap (used once by scripts/create-admin.js, then ignored) ----
ADMIN_SETUP_NAME=
ADMIN_SETUP_MOBILE=
ADMIN_SETUP_EMAIL=
ADMIN_SETUP_PASSWORD=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
